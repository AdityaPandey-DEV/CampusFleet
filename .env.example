# ==============================================================================
# BusSync: Smart Campus Transport & Bus Management System
# Environment Configuration
# ==============================================================================

# Supabase Public Configuration (Client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Side Secret Key (DO NOT EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL (For authentication callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Institutional Admin Email
NEXT_PUBLIC_ADMIN_EMAIL=campusfleet@gmail.com

# JWT Secret for Session Cookies
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters

# Google OAuth 2.0 (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gmail SMTP for OTP Verification
GMAIL_USER=campusfleet@gmail.com
GMAIL_APP_PASSWORD=your-16-char-google-app-password

